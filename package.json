{
  "name": "microsoft-edge",
  "productName": "Microsoft Edge",
  "version": "1.0.0",
  "description": "Microsoft Edge",
  "private": true,
  "main": "main.js",
  "author": "idgroup5858",
  "scripts": {
    "build:react": "node scripts/build-react.js",
    "generate-icon": "node scripts/generate-icon.js",
    "start": "npm run build:react && electron .",
    "dist": "npm run build:react && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "uz.holy.quron",
    "productName": "Microsoft Edge",
    "copyright": "Copyright (c) 2026",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "decoy/**/*",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Microsoft Edge"
    }
  }
}
